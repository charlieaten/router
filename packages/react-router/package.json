{
  "name": "@tanstack/react-router",
  "version": "1.170.46",
  "description": "Modern and scalable routing for React applications",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/router.git",
    "directory": "packages/react-router"
  },
  "homepage": "https://tanstack.com/router",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "react",
    "location",
    "router",
    "routing",
    "async",
    "async router",
    "typescript"
  ],
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./coverage",
    "test:eslint": "eslint",
    "test:types": "pnpm run \"/^test:types:ts[0-9]{2}$/\"",
    "test:types:ts56": "node ../../node_modules/typescript56/lib/tsc.js -p tsconfig.legacy.json",
    "test:types:ts57": "node ../../node_modules/typescript57/lib/tsc.js -p tsconfig.legacy.json",
    "test:types:ts58": "node ../../node_modules/typescript58/lib/tsc.js -p tsconfig.legacy.json",
    "test:types:ts59": "node ../../node_modules/typescript59/lib/tsc.js -p tsconfig.legacy.json",
    "test:types:ts60": "tsc6 -p tsconfig.legacy.json",
    "test:types:ts70": "tsc -p tsconfig.legacy.json",
    "test:unit": "vitest",
    "test:unit:native": "vitest --config vite.native.config.ts",
    "test:types:native": "tsc6 --project tsconfig.native.json && tsc6 --project tsconfig.native.inference.json",
    "test:unit:dev": "pnpm run test:unit --watch --hideSkippedTests",
    "test:perf": "vitest bench",
    "test:perf:dev": "pnpm run test:perf --watch --hideSkippedTests",
    "test:build": "publint --strict && attw --ignore-rules no-resolution --pack .",
    "build": "vite build && vite build --config vite.native.build.config.ts && tsc6 --project tsconfig.native.build.json && node scripts/native-declarations.mjs",
    "test:perf:native": "vitest bench --mode benchmark --config vite.native.config.ts tests/native-navigation.bench.tsx"
  },
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/esm/index.native.d.ts",
        "default": "./dist/native/esm/index.native.js"
      },
      "react-server": {
        "types": "./dist/esm/index.rsc.d.ts",
        "default": "./dist/esm/index.rsc.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "development": "./dist/esm/index.dev.js",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "development": "./dist/cjs/index.dev.cjs",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./ssr/server": {
      "import": {
        "types": "./dist/esm/ssr/server.d.ts",
        "default": "./dist/esm/ssr/server.js"
      },
      "require": {
        "types": "./dist/cjs/ssr/server.d.cts",
        "default": "./dist/cjs/ssr/server.cjs"
      }
    },
    "./ssr/client": {
      "import": {
        "types": "./dist/esm/ssr/client.d.ts",
        "default": "./dist/esm/ssr/client.js"
      },
      "require": {
        "types": "./dist/cjs/ssr/client.d.cts",
        "default": "./dist/cjs/ssr/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "skills",
    "!skills/_artifacts"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@tanstack/history": "workspace:*",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/router-core": "workspace:*",
    "isbot": "catalog:",
    "standard-navigation": "0.0.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/vite-config": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": ">=20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "combinate": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.1",
    "react-native-screens": "5.0.0-beta.1",
    "rimraf": "catalog:",
    "vite": "*",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0",
    "react-native": ">=0.84.0",
    "react-native-screens": ">=5.0.0-beta.1"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "nx": {
    "targets": {
      "test:unit:native": {
        "dependsOn": [
          "^build",
          "build"
        ]
      }
    }
  }
}
