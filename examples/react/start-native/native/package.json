{
  "name": "tanstack-start-native-client",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "generate": "node generate.mjs",
    "build:ios": "pnpm generate && expo export --platform ios",
    "dev": "pnpm generate && expo start --dev-client --port 8088",
    "ios": "pnpm generate && expo run:ios --port 8088",
    "android": "pnpm generate && expo run:android --port 8088",
    "test:types": "tsc --noEmit -p ../tsconfig.native.json"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.6",
    "expo": "58.0.24",
    "expo-dev-client": "58.0.19",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "5.0.0-beta.2",
    "react-native-svg": "15.16.0",
    "react-native-tab-view": "^4.3.4",
    "react-native-worklets": "0.13.0",
    "standard-navigation": "0.0.9",
    "zod": "^4.5.4"
  },
  "nx": {
    "targets": {
      "build:ios": {
        "dependsOn": [
          "^build"
        ],
        "cache": false,
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tanstack/router-generator": "^1.166.7",
    "@types/react": "^19.2.8",
    "babel-preset-expo": "~58.0.25",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
